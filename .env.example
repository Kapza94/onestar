# Convex development deployment
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Signed anonymous session cookie
ANON_SESSION_SECRET=replace-with-at-least-32-random-bytes

# openai | xai | gemini
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING=none
XAI_API_KEY=
XAI_MODEL=grok-3-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

EXA_API_KEY=
FIRECRAWL_API_KEY=
DEMO_MODE=false
RESEARCH_ENABLED=true
