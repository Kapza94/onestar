# openai | gemini | xai
AI_PROVIDER=openai

# OpenAI (GPT-5.6 Luna is the cheap default)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# none | low | medium | high | xhigh | max
OPENAI_REASONING=none

# xAI (only if hackathon credits are available)
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Research
EXA_API_KEY=
FIRECRAWL_API_KEY=

# When true, skip live research and label reports as example data. Keep false on clean-live.
DEMO_MODE=false
