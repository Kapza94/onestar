{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onestar",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "onestar.cc", "custom_domain": true },
    { "pattern": "www.onestar.cc", "custom_domain": true }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "onestar"
    }
  ],
  "ratelimits": [
    {
      "name": "ANALYZE_BURST_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 2,
        "period": 60
      }
    },
    {
      "name": "ANALYZE_GLOBAL_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "vars": {
    "AI_PROVIDER": "openai",
    "OPENAI_MODEL": "gpt-5.6-luna",
    "OPENAI_REASONING": "none",
    "DEMO_MODE": "false",
    "RESEARCH_ENABLED": "true"
  }
}
